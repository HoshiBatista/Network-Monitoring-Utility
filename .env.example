# Application
APP_NAME="Network Monitoring Utility"
APP_VERSION="0.1.0"
DEBUG=false

# Database
DATABASE_URL="sqlite+aiosqlite:///./network_monitor.db"

# Monitoring worker
MONITORING_INTERVAL_SECONDS=30
MONITORING_TIMEOUT_SECONDS=5.0

# Logging — console
LOG_LEVEL=INFO

# Logging — file sink (comment out LOG_FILE to disable file logging)
# LOG_FILE=logs/app.log
LOG_ROTATION="10 MB"
LOG_RETENTION="1 week"

# Server
HOST=0.0.0.0
PORT=8000
